### Define functions
# Create directory and change to it
function md() { [[ $# == 1 ]] && mkdir -p -- "$1" && builtin cd -- "$1" }

# Find all files containing '$1' in it's name
function fn() { find -name "*$1*" | bat -p --style=numbers }

# Use bat as pager when browsing help pages
function help() {
    local cmd=("$@")

    if [[ -n ${aliases["$*"]} ]]; then
        read -r -a cmd <<< "${aliases["$*"]}"
    fi

    "${cmd[@]}" --help 2>&1 | bat -plhelp
}

# Clear terminal and scrollback history
function cls() {
	clear && printf '\e[3J'
	zle && zle .reset-prompt && zle -R
}
zle -N cls

# Django Management with uv
uvm() {
    local manage_file
    manage_file=$(find . -maxdepth 2 -type f -name manage.py -print -quit)

    if [[ -n "$manage_file" ]]; then
        uv run "$manage_file" "$@"
    else
        echo "manage.py not found in the current directory or its subdirectories."
    fi
}

