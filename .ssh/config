Host gh-personal
HostName github.com
User git
IdentityFile ~/.ssh/gh-personal
IdentitiesOnly yes
ControlPath ~/.ssh/s/%r@gh_personal-%p

Host gh-company
HostName github.com
User git
IdentityFile ~/.ssh/gh-company
IdentitiesOnly yes
ControlPath ~/.ssh/s/%r@gh_company-%p

Host workspace
HostName codeserver.42sp.org.br
StrictHostKeyChecking no
UserKnownHostsFile=/dev/null
User coder

Host *
ServerAliveInterval 60
ConnectTimeout 10
AddKeysToAgent yes
EscapeChar `
ControlMaster auto
ControlPersist 72000
ControlPath ~/.ssh/s/%C
